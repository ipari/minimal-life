---
import BaseLayout from "./BaseLayout.astro";
import type { Lang } from "../lib/i18n";
import { formatDate, ui } from "../lib/i18n";

interface Props {
  title: string;
  lang: Lang;
  date: Date;
  alternateUrl: string;
}

const { title, lang, date, alternateUrl } = Astro.props;
const t = ui[lang];
---

<BaseLayout {lang} {title} {alternateUrl}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <time class="post-date" datetime={date.toISOString()}>{formatDate(date, lang)}</time>
    </header>
    <div class="post-content"><slot /></div>
    <aside class="author-card" aria-labelledby="author-card-title">
      <p class="author-card-label" id="author-card-title">{t.author_title}</p>
      <p>{t.author_summary}</p>
      <a href={`/${lang}/about/`}>{t.author_more} &rarr;</a>
    </aside>
  </article>
</BaseLayout>
